        <field>leave_type</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Leave balance check confirmation</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var leaveType = g_form.getValue('leave_type');
    var startStr = g_form.getValue('start_date');
    var endStr = g_form.getValue('end_date');

    // Make sure we have the required data before calling the server
    if (!leaveType) {
        return;
    }


    // Call the Script Include
    var ga = new GlideAjax('LeaveBalanceAjax'); // Name of the Script Include
    ga.addParam('sysparm_name', 'getLeaveBalance'); // Name of the function
    ga.addParam('sysparm_user', g_user.userID); // Pass the current user ID
    ga.addParam('sysparm_leave_type', leaveType); // Pass the selected leave type

    // Use getXMLAnswer for a cleaner, modern callback
    ga.getXMLAnswer(function(response) {
        var balance = parseInt(response, 10);
        
        alert("Your balance for " + leaveType + " leave is: " + balance);

        // Example validation:
        // if (daysRequested > balance) {
        //     g_form.showFieldMsg('end_date', 'You do not have enough leave balance.', 'error');
        // }
    });
   
}]]></script>
