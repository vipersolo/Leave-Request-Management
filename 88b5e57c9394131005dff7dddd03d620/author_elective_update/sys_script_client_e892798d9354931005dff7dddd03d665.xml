        <messages/>
        <name>medical required for days greater than 2</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   //Type appropriate comment here, and begin script below
   var startDateStr = g_form.getValue('start_date');
    var endDateStr = g_form.getValue('end_date');

    if (startDateStr !== '' && endDateStr !== '') {
        
        var startMs = getDateFromFormat(startDateStr, g_user_date_format);
        var endMs = getDateFromFormat(endDateStr, g_user_date_format);
        
        // Calculate difference in days 
        // We add +1 because leave days are inclusive (e.g., Mon to Mon is 1 day of leave)
        var diffInMs = endMs - startMs;
        var diffInDays = Math.round(diffInMs / (1000 * 60 * 60 * 24)) + 1;

        // NOTE: Replace 'sick' with the exact backend value of your Sick Leave choice
        if (newValue === 'sick' && diffInDays > 2) {
            
            g_form.addInfoMessage('A medical certificate is required for Sick Leave exceeding 2 days. Please upload it before submitting.');
            
        
            g_form.setMandatory('document_attachment', true);

    
        } 
    }
   
}]]></script>
