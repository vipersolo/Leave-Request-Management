        <messages/>
        <name>Number of leave Days </name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

    	var startStr = g_form.getValue('start_date');
		var endStr = g_form.getValue('end_date');

		var startDate = getDateFromFormat(startStr, g_user_date_format);
		var endDate = getDateFromFormat(endStr, g_user_date_format);

		// Calculate the difference in days
		var diffInMs = endDate - startDate;
		var days = diffInMs / (1000 * 60 * 60 * 24);
		days++;

		g_form.setValue('number_of_leave_days', days);

}

		
		]]></script>
